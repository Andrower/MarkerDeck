{
  "name": "markerdeck-electron-client",
  "version": "1.7.0",
  "private": true,
  "main": "main.js",
  "description": "Desktop locked client shell for MarkerDeck",
  "scripts": {
    "start": "electron .",
    "prepare:ffmpeg:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../platform/windows/prepare-ffmpeg.ps1",
    "build:win": "pnpm run prepare:ffmpeg:win && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.markerdeck.client",
    "productName": "MarkerDeck",
    "artifactName": "MarkerDeck.Client.${version}.${ext}",
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../../src",
        "to": "server",
        "filter": [
          "markerdeck-server.js",
          "markerdeck-host-discovery.js",
          "markerdeck-mdns.js",
          "web/**"
        ]
      },
      {
        "from": "../../node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../runtime/windows/node-windows",
        "to": "server/node-windows",
        "filter": [
          "node.exe"
        ]
      },
      {
        "from": "../../runtime/windows/ffmpeg-windows",
        "to": "server/ffmpeg-windows",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "zip"
      ]
    }
  }
}
