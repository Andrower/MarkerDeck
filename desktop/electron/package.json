{
  "name": "chroma-cross-electron-client",
  "version": "1.2.0",
  "private": true,
  "main": "main.js",
  "description": "Desktop locked client shell for Chroma Cross",
  "scripts": {
    "start": "electron .",
    "prepare:ffmpeg:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../platform/windows/prepare-ffmpeg.ps1",
    "build:win": "pnpm run prepare:ffmpeg:win && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.chroma.cross.client",
    "productName": "Chroma Cross Video Client",
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../../src",
        "to": "server",
        "filter": [
          "chroma-control-server.js",
          "web/**"
        ]
      },
      {
        "from": "../../runtime/windows/node-windows",
        "to": "server/node-windows",
        "filter": [
          "node.exe"
        ]
      },
      {
        "from": "../../runtime/windows/ffmpeg-windows",
        "to": "server/ffmpeg-windows",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
